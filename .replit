modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "os-portfolio-persistence"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "workspace-quality"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "os-portfolio-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "os-portfolio-ds-token-drift"

[[workflows.workflow]]
name = "os-portfolio-persistence"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/os-portfolio run test:e2e:persistence"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "workspace-quality"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck && pnpm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "os-portfolio-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/os-portfolio run test:e2e"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "os-portfolio-ds-token-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "before=$(sha256sum artifacts/os-portfolio-ds/src/index.css artifacts/os-portfolio-ds/src/generated/tokens.tsx artifacts/os-portfolio-ds/public/favicon.svg); pnpm --filter @workspace/os-portfolio-ds run tokens; after=$(sha256sum artifacts/os-portfolio-ds/src/index.css artifacts/os-portfolio-ds/src/generated/tokens.tsx artifacts/os-portfolio-ds/public/favicon.svg); test \"$before\" = \"$after\""

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "mesa", "pango", "cairo", "alsa-lib", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "libgbm", "xorg.libXcursor", "xorg.libXi", "gtk3", "gdk-pixbuf", "webkitgtk_6_0", "icu74", "libjpeg8", "libmanette", "libsecret", "libglvnd", "x264", "hyphen"]
