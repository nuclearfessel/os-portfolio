{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#eaf3ef" },
      "foreground": { "$value": "#17233a" },
      "border": { "$value": "#a9c5bd" },
      "card": { "$value": "#f7fbf9" },
      "cardForeground": { "$value": "#17233a" },
      "popover": { "$value": "#f2f8f5" },
      "popoverForeground": { "$value": "#17233a" },
      "primary": {
        "$value": "#0b665d",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#f7fbf9" },
      "secondary": { "$value": "#dceae5" },
      "secondaryForeground": { "$value": "#17233a" },
      "muted": { "$value": "#e2ece8" },
      "mutedForeground": { "$value": "#536a72" },
      "accent": { "$value": "#c54f48" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#b63f4d" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#8db3aa" },
      "ring": { "$value": "#0b665d" },
      "chart1": { "$value": "#0b665d" },
      "chart2": { "$value": "#c54f48" },
      "chart3": { "$value": "#287f8f" },
      "chart4": { "$value": "#6f5ca8" },
      "chart5": { "$value": "#b77824" },
      "sidebar": { "$value": "#e2ece8" },
      "sidebarForeground": { "$value": "#17233a" },
      "sidebarBorder": { "$value": "#a9c5bd" },
      "sidebarPrimary": { "$value": "#0b665d" },
      "sidebarPrimaryForeground": { "$value": "#f7fbf9" },
      "sidebarAccent": { "$value": "#cfdfda" },
      "sidebarAccentForeground": { "$value": "#17233a" },
      "sidebarRing": { "$value": "#0b665d" }
    },
    "dark": {
      "background": { "$value": "#111326" },
      "foreground": { "$value": "#e8eaf4" },
      "border": { "$value": "#444967" },
      "card": { "$value": "#20233d" },
      "cardForeground": { "$value": "#e8eaf4" },
      "popover": { "$value": "#1d2036" },
      "popoverForeground": { "$value": "#e8eaf4" },
      "primary": { "$value": "#e4ff5b" },
      "primaryForeground": { "$value": "#111326" },
      "secondary": { "$value": "#2b2f4a" },
      "secondaryForeground": { "$value": "#e8eaf4" },
      "muted": { "$value": "#2b2f4a" },
      "mutedForeground": { "$value": "#aeb2cb" },
      "accent": { "$value": "#ff8d79" },
      "accentForeground": { "$value": "#111326" },
      "destructive": { "$value": "#e46765" },
      "destructiveForeground": { "$value": "#111326" },
      "input": { "$value": "#4b526d" },
      "ring": { "$value": "#e4ff5b" },
      "chart1": { "$value": "#e4ff5b" },
      "chart2": { "$value": "#ff8d79" },
      "chart3": { "$value": "#86d9ee" },
      "chart4": { "$value": "#b996ed" },
      "chart5": { "$value": "#f5b85c" },
      "sidebar": { "$value": "#181b30" },
      "sidebarForeground": { "$value": "#e8eaf4" },
      "sidebarBorder": { "$value": "#444967" },
      "sidebarPrimary": { "$value": "#e4ff5b" },
      "sidebarPrimaryForeground": { "$value": "#111326" },
      "sidebarAccent": { "$value": "#2b2f4a" },
      "sidebarAccentForeground": { "$value": "#e8eaf4" },
      "sidebarRing": { "$value": "#e4ff5b" }
    },
    "fixed": {
      "$description": "Fixed palette tokens that remain constant regardless of theme. Used by accessibility contrast themes and wallpaper presets.",
      "wallpaperLightDefault": {
        "$value": "#e8f0ec",
        "$description": "Light-mode solid-color wallpaper preset. Muted sage/green tint."
      },
      "wallpaperDarkDefault": {
        "$value": "#111326",
        "$description": "Dark-mode solid-color wallpaper preset. Deep navy/charcoal."
      },
      "lowContrastBg": {
        "$value": "#282a38",
        "$description": "Low-contrast theme background. Softer dark, reduces visual harshness."
      },
      "lowContrastSurface": {
        "$value": "#31334a",
        "$description": "Low-contrast surface (windows, cards)."
      },
      "lowContrastSurface2": {
        "$value": "#3a3c52",
        "$description": "Low-contrast elevated surface."
      },
      "lowContrastText": {
        "$value": "#c4c8da",
        "$description": "Low-contrast body text."
      },
      "lowContrastTextMuted": {
        "$value": "#8e92a8",
        "$description": "Low-contrast secondary/muted text."
      },
      "lowContrastAccent": {
        "$value": "#8fa8c8",
        "$description": "Low-contrast accent/interactive. Blue-grey, less vivid than primary."
      },
      "highContrastBg": {
        "$value": "#000000",
        "$description": "High-contrast theme background. Pure black."
      },
      "highContrastSurface": {
        "$value": "#0d0d0d",
        "$description": "High-contrast surface (windows)."
      },
      "highContrastSurface2": {
        "$value": "#1a1a1a",
        "$description": "High-contrast elevated surface."
      },
      "highContrastText": {
        "$value": "#ffffff",
        "$description": "High-contrast body text. Pure white."
      },
      "highContrastTextMuted": {
        "$value": "#e0e0e0",
        "$description": "High-contrast secondary text."
      },
      "highContrastAccent": {
        "$value": "#ffff00",
        "$description": "High-contrast accent. Maximum yellow visibility on black."
      },
      "highContrastAccentAlt": {
        "$value": "#00ffff",
        "$description": "High-contrast alternate accent (cyan)."
      },
      "highContrastBorder": {
        "$value": "#ffffff",
        "$description": "High-contrast border. Pure white on black backgrounds."
      },
      "highContrastFocus": {
        "$value": "#ffff00",
        "$description": "High-contrast focus-ring color."
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Space Grotesk", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["DM Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
